{
  "name": "buildflow-android",
  "version": "0.1.0",
  "private": true,
  "description": "Android shell (Capacitor) that loads the hosted BuildFlow web app. No business logic lives here.",
  "scripts": {
    "sync": "cap sync android",
    "build:debug": "cd android && ./gradlew assembleDebug",
    "build:bundle": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3"
  }
}
