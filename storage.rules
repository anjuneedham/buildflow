rules_version = '2';

// All uploads and downloads go through the server (Admin SDK): uploads are
// validated by their real bytes and re-encoded; private files are served
// only after a membership check. No Firebase client access to Storage.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
