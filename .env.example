# --- Firebase web app config (Project settings → Your apps). Safe in the browser. ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (SERVER ONLY, never NEXT_PUBLIC_) ---
# Service account JSON (raw or base64). Not needed with the emulators.
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Local development with the Firebase emulators (npm run emulators) ---
# Uncomment for local dev; leave unset in production.
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@buildflow.example

# --- Stripe (optional in V1; billing runs in "manual" mode when unset) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
