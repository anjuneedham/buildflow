# BuildFlow environment variables. Copy to .env.local for local development.
# Three environments, each with its OWN Firebase project (ARCHITECTURE_V2.md §13):
#   local       Firebase emulators, demo-* project id, seed data
#   staging     buildflow-staging (real indexes, rules, storage; test accounts)
#   production  buildflow-prod
# staging/production refuse to start if emulator variables are set or required
# values are missing (src/lib/env.ts → serverEnvProblems).

# --- Environment ---
NEXT_PUBLIC_APP_ENV=local            # local | staging | production

# --- Firebase web app config (Project settings → Your apps). Safe in the browser. ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (SERVER ONLY, never NEXT_PUBLIC_) ---
# Service account JSON (raw or base64). Leave empty with the emulators, or on
# Google-hosted runtimes that provide Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Local development with the Firebase emulators (npm run emulators) ---
# Local only. Must be unset in staging and production.
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # must be https:// in staging/production
NEXT_PUBLIC_SUPPORT_EMAIL=support@buildflow.example   # must be a real address in production

# --- Legal (shown in the Privacy Policy, Terms and Refund policy). Required in production. ---
NEXT_PUBLIC_LEGAL_COMPANY_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_GOVERNING_LAW=
NEXT_PUBLIC_LEGAL_REVIEWED=false    # set to true only after counsel has reviewed the policies

# --- Billing (not wired yet; provider decision pending, ARCHITECTURE_V2.md §10) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server Actions encrypt the arguments they close over. With more than one server instance, or when people keep a tab open
# across a deploy, every instance and build must share one key or actions fail with "Failed to find Server Action".
# Generate once: openssl rand -base64 32   (set it at build time and at runtime)
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
