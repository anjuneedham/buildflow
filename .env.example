# --- Supabase (required) ---
# Project URL and anon/publishable key: safe to expose to the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key: SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used only by admin tooling.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@buildflow.example

# --- Stripe (optional in V1; billing runs in "manual" mode when unset) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email (optional; notifications are stored in-app regardless) ---
RESEND_API_KEY=
EMAIL_FROM="BuildFlow <notifications@buildflow.example>"
