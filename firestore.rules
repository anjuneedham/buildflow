rules_version = '2';

// BuildFlow: all Firestore access is server-side (Admin SDK, which bypasses
// these rules) after session verification and the policy checks in
// src/server/policy.ts. The browser bundle does not include the Firestore
// SDK, so no client path exists; these rules prove that by denying every
// client read and write (ARCHITECTURE_V2.md §1, FIRESTORE_SCHEMA_V2.md §7).
//
// A future feature that needs live client listeners must add a narrowly
// scoped rule, tests for it, and update FIRESTORE_SCHEMA_V2.md.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
